:root { color: rgb(231, 238, 235); -unity-font-style: normal; font-size: 16px; }
#screen { flex-grow: 1; background-color: rgba(3, 10, 13, 0.08); }
.shade { position: absolute; left: 0; top: 0; bottom: 0; width: 47%; background-color: rgba(3, 10, 13, 0.68); border-right-width: 1px; border-right-color: rgba(102, 239, 207, 0.09); }
.topbar { position: absolute; left: 5%; right: 5%; top: 5%; flex-direction: row; justify-content: space-between; align-items: center; padding-bottom: 21px; border-bottom-width: 1px; border-bottom-color: rgba(176, 218, 209, 0.2); }
.brand { font-size: 17px; letter-spacing: 3px; -unity-font-style: bold; }
.micro { font-size: 11px; letter-spacing: 1.4px; }
.muted { color: rgb(126, 152, 153); }
.cyan { color: rgb(101, 235, 203); }
#menu { position: absolute; left: 7%; top: 23%; width: 39%; max-width: 620px; }
.eyebrow { color: rgb(101, 235, 203); font-size: 12px; letter-spacing: 3px; margin-bottom: 16px; }
.title { font-size: 78px; -unity-font-style: bold; letter-spacing: -3px; margin-left: -4px; }
.title-rule { width: 55px; height: 4px; margin-top: 13px; margin-bottom: 21px; background-color: rgb(240, 155, 89); }
.tagline { font-size: 25px; margin-bottom: 12px; }
.description { color: rgb(151, 170, 174); font-size: 16px; white-space: normal; max-width: 360px; }
.navigation { margin-top: 30px; width: 365px; }
Button { border-radius: 0; border-width: 0; margin: 0; margin-bottom: 6px; padding: 0 20px; height: 46px; -unity-text-align: middle-left; font-size: 12px; letter-spacing: 1.3px; transition-property: background-color, color, translate; transition-duration: 0.18s; }
Button:hover, Button:focus { translate: 4px 0; }
.primary { background-color: rgb(240, 155, 89); color: rgb(19, 25, 26); -unity-font-style: bold; height: 55px; margin-bottom: 15px; }
.primary:hover, .primary:focus { background-color: rgb(255, 190, 125); color: rgb(0, 0, 0); }
.secondary { background-color: rgba(17, 34, 39, 0.78); color: rgb(196, 214, 213); border-bottom-width: 1px; border-bottom-color: rgba(111, 164, 155, 0.22); }
.secondary:hover, .secondary:focus { background-color: rgb(34, 64, 65); color: rgb(126, 255, 220); }
.muted-button { color: rgb(139, 166, 166); }
.motto { margin-top: 22px; font-size: 9px; color: rgb(105, 133, 135); }
#subject { position: absolute; right: 5%; top: 34%; border-left-width: 1px; border-left-color: rgba(103, 230, 205, 0.4); padding-left: 16px; }
.subject-name { font-size: 26px; margin-top: 9px; margin-bottom: 15px; }
.telemetry { font-size: 10px; color: rgb(129, 165, 163); white-space: normal; letter-spacing: 1px; }
#intro { position: absolute; left: 7%; top: 39%; }
.intro-title { font-size: 38px; white-space: normal; }
.skip { background-color: transparent; color: rgb(153, 198, 189); padding-left: 0; margin-top: 25px; font-size: 11px; }
.skip:hover, .skip:focus { color: white; background-color: rgba(64, 137, 120, 0.3); }
.footer { position: absolute; left: 5%; right: 5%; bottom: 5%; border-top-width: 1px; border-top-color: rgba(176, 218, 209, 0.2); padding-top: 20px; flex-direction: row; align-items: center; justify-content: space-between; }
.progress { height: 2px; width: 15%; background-color: rgb(34, 60, 61); }
#progress-fill { height: 2px; width: 0; background-color: rgb(101, 235, 203); }
#modal { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(2, 8, 11, 0.94); align-items: center; justify-content: center; }
.dialog { width: 580px; max-width: 90%; padding: 40px; background-color: rgb(10, 23, 29); border-top-width: 3px; border-top-color: rgb(101, 235, 203); }
.dialog-title { font-size: 29px; -unity-font-style: bold; white-space: normal; margin-top: 10px; margin-bottom: 24px; }
.dialog-body { font-size: 17px; white-space: normal; color: rgb(170, 194, 192); margin-bottom: 26px; }
#settings-fields { margin-bottom: 28px; }
#volume, #motion { margin-top: 15px; margin-bottom: 15px; color: rgb(208, 225, 222); }
#volume .unity-base-field__label, #motion .unity-base-field__label { min-width: 180px; }
#fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(2, 6, 9); }
